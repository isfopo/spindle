{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "jsxImportSource": "hono/jsx",
    "strict": true,
    "skipLibCheck": true,
    "noImplicitOverride": true,
    "lib": ["ESNext", "DOM"],
    "paths": {"*": ["../packages/*"]}
  },
  "include": ["./**/*.ts", "./**/*.tsx"],
}
